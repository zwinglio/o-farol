---
import Base from '../../layouts/Base.astro';
import { confirm, validToken } from '../../lib/newsletter';

const token = Astro.url.searchParams.get('token');
const result = validToken(token) ? await confirm(token) : 'invalid';
---

<Base title="Confirmar inscrição" noindex>
  <div class="measure">
    {result === 'ok' && (
      <>
        <h1>Inscrição confirmada</h1>
        <p class="intro">Pronto! A partir da próxima edição, as notícias do Farol chegam no seu e-mail.</p>
      </>
    )}
    {result === 'invalid' && (
      <>
        <h1>Link inválido</h1>
        <p class="intro">Este link de confirmação não vale mais. <a href="/newsletter">Inscreva-se de novo</a> para receber um novo.</p>
      </>
    )}
    {result === 'error' && (
      <>
        <h1>Algo deu errado</h1>
        <p class="intro">Não conseguimos confirmar agora. Tente abrir o link de novo em alguns minutos.</p>
      </>
    )}
    <p><a href="/">Ir para a capa</a></p>
  </div>
</Base>

<style>
  h1 { font-family: var(--serif); font-size: 2.4rem; line-height: 1.1; margin: 0 0 0.75rem; }
  .intro { margin: 0 0 1.5rem; color: var(--muted); font-family: var(--serif); font-size: 1.15rem; }
</style>
