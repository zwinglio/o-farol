---
/**
 * Botões de compartilhamento da matéria. Só links simples (sem SDK nem
 * script de terceiros, por causa da CSP); no celular, o botão
 * "Compartilhar" abre a folha nativa do sistema (Web Share API).
 */
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const networks = [
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, icon: 'M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .1-3.3-.8-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.4 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.3Z' },
  { name: 'X', href: `https://x.com/intent/post?text=${t}&url=${u}`, icon: 'M17.8 3h3.1l-6.8 7.7L22 21h-6.2l-4.9-6.4L5.3 21H2.2l7.2-8.3L1.8 3h6.4l4.4 5.8L17.8 3Zm-1.1 16.2h1.7L7.4 4.7H5.6l11.1 14.5Z' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, icon: 'M14 13.5h2.5l1-4H14v-2c0-1 0-2 2-2h1.5V2.1C17.2 2.1 15.9 2 14.5 2 11.6 2 10 3.7 10 6.8v2.7H7v4h3V22h4v-8.5Z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}`, icon: 'M21.4 3.6 2.9 10.7c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.8.8.4 0 .6-.2.9-.5l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.9-1.3-1.5Z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, icon: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9.5h4V21H3V9.5Zm6.5 0h3.8v1.6h.1c.5-1 1.8-2 3.8-2 4 0 4.8 2.6 4.8 6V21h-4v-5.2c0-1.2 0-2.8-1.7-2.8s-2 1.3-2 2.7V21h-4V9.5Z' },
];
---

<div class="share" data-share data-url={url} data-title={title}>
  <span class="label">Compartilhe</span>
  <ul>
    {networks.map((n) => (
      <li>
        <a href={n.href} target="_blank" rel="noopener noreferrer" aria-label={`Compartilhar no ${n.name}`} title={n.name}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={n.icon} /></svg>
        </a>
      </li>
    ))}
    <li>
      <button type="button" data-copy aria-label="Copiar link" title="Copiar link">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
      </button>
    </li>
    <li class="native" hidden>
      <button type="button" data-native aria-label="Compartilhar" title="Compartilhar">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4" /></svg>
      </button>
    </li>
  </ul>
  <span class="status" role="status" aria-live="polite"></span>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const url = el.dataset.url!;
    const title = el.dataset.title!;
    const status = el.querySelector<HTMLElement>('.status')!;

    el.querySelector('[data-copy]')?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = 'Link copiado';
      } catch {
        status.textContent = 'Não foi possível copiar';
      }
      setTimeout(() => (status.textContent = ''), 2500);
    });

    if (typeof navigator.share === 'function') {
      el.querySelector<HTMLElement>('.native')!.hidden = false;
      el.querySelector('[data-native]')!.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  }
</script>

<style>
  .share { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
  .label { font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  ul { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  a, button {
    display: grid; place-items: center; width: 2.25rem; height: 2.25rem;
    border: 1px solid var(--line); border-radius: 50%; background: none;
    color: var(--text); cursor: pointer; transition: color 0.15s, border-color 0.15s;
  }
  a:hover, a:focus-visible, button:hover, button:focus-visible { color: var(--accent); border-color: var(--accent); }
  svg { width: 1.05rem; height: 1.05rem; }
  a svg { fill: currentColor; }
  .status { font-size: 0.8rem; color: var(--muted); }
</style>
