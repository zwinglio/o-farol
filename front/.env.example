# URL pública deste front (usada em canonical, Open Graph e links absolutos)
PUBLIC_SITE_URL=https://ofarol.com.br

# Raiz da REST API do WordPress (VPS do CMS). Sem barra no final.
WP_API_URL=https://cms.ofarol.com.br/wp-json

# Tempo máximo de espera por uma resposta do CMS (ms)
WP_API_TIMEOUT_MS=8000

# Domínio da mídia (R2). Opcional: só precisa se não for https (testes locais).
# MEDIA_URL=

# Cache HTTP das páginas, em segundos (para CDN/proxy reverso)
CACHE_MAX_AGE=60

# Servidor (lido pelo adapter Node). Em produção, só 127.0.0.1: o nginx fica na frente.
HOST=127.0.0.1
PORT=4321
