# =====================================================================
#  O Farol — CMS (WordPress headless)
#  Em produção, coloque este arquivo UM NÍVEL ACIMA da raiz pública
#  (ex.: /var/www/.env com o WordPress em /var/www/ofarol).
# =====================================================================

WP_ENVIRONMENT_TYPE=production   # local | development | staging | production
WP_DEBUG=false

# --- Banco de dados (MySQL 8+ / MariaDB 10.6+) ---
DB_NAME=ofarol
DB_USER=ofarol
DB_PASSWORD=troque-me
DB_HOST=localhost
DB_PREFIX=wp_
DB_CHARSET=utf8mb4

# --- Servidor ---
# true só se um proxy à frente (Cloudflare, Traefik…) termina o HTTPS e envia
# X-Forwarded-Proto. Com nginx + certificado no próprio VPS, deixe false.
FAROL_TRUST_PROXY=false
# Em produção o padrão é true: plugins, temas e core só mudam via git.
# DISALLOW_FILE_MODS=true

# --- URLs ---
# Onde o painel/API respondem
WP_HOME=https://cms.ofarol.com.br
WP_SITEURL=https://cms.ofarol.com.br

# --- Integração com o front (Astro) ---
# Site público: usado nos links "Ver post" do painel e no redirecionamento
# de quem abrir o CMS direto no navegador.
FAROL_FRONTEND_URL=https://ofarol.com.br
# Origens que o navegador pode usar para chamar a REST API (separadas por vírgula).
# O Astro busca os dados no servidor e não precisa de CORS; isto vale para
# chamadas feitas no navegador (busca, contadores, etc. no futuro).
FAROL_CORS_ORIGINS=https://ofarol.com.br,https://www.ofarol.com.br

# --- Inteligência artificial (OpenRouter) ---
# Opcional: se definida aqui, tem prioridade sobre a chave cadastrada no painel
# (Configurações → O Farol → IA). Crie em https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Chaves de segurança ---
# Obrigatórias em produção (o site não sobe sem elas). Gere com:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# ou https://api.wordpress.org/secret-key/1.1/salt/ (cole só os valores, entre aspas).
AUTH_KEY=
SECURE_AUTH_KEY=
LOGGED_IN_KEY=
NONCE_KEY=
AUTH_SALT=
SECURE_AUTH_SALT=
LOGGED_IN_SALT=
NONCE_SALT=

# --- Mídia no Cloudflare R2 (plugin farol-midia) ---
# Sem estas variáveis, imagens e vídeos ficam no próprio servidor.
# Token: R2 → Manage API tokens → Object Read & Write, só no bucket da mídia.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Domínio público conectado ao bucket (Custom Domain), sem barra no final.
R2_PUBLIC_URL=
# true: guarda também uma cópia no servidor. Depois de validar, false
# (e `wp farol-midia prune-local` apaga as cópias antigas).
R2_KEEP_LOCAL=true
